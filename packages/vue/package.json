{
  "name": "@use-stellar/vue",
  "version": "0.1.0",
  "description": "Vue 3 composables for the Stellar network",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./test-utils": {
      "import": {
        "types": "./dist/test-utils.d.mts",
        "default": "./dist/test-utils.mjs"
      },
      "require": {
        "types": "./dist/test-utils.d.ts",
        "default": "./dist/test-utils.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "jest",
    "test:watch": "jest --watch",
    "typecheck": "tsc --noEmit",
    "size": "size-limit",
    "size:why": "size-limit --why"
  },
  "peerDependencies": {
    "vue": "^3.3.0"
  },
  "dependencies": {
    "@stellar/stellar-sdk": "^12.0.0",
    "use-stellar": "workspace:*"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "@size-limit/esbuild": "12.1.0",
    "@size-limit/esbuild-why": "12.1.0",
    "@size-limit/preset-small-lib": "^12.1.0",
    "jest": "^29.0.0",
    "size-limit": "^12.1.0",
    "ts-jest": "^29.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.9.3",
    "vue": "^3.5.0"
  },
  "size-limit": [
    {
      "name": "Vue CommonJS bundle",
      "path": "dist/index.js",
      "limit": "15 kB",
      "ignore": [
        "@stellar/stellar-sdk",
        "vue"
      ]
    },
    {
      "name": "Vue ES module bundle",
      "path": "dist/index.mjs",
      "limit": "11 kB",
      "ignore": [
        "@stellar/stellar-sdk",
        "vue"
      ]
    }
  ]
}
