{
  "name": "@use-stellar/react-native",
  "version": "0.1.5",
  "description": "React Native hooks for the Stellar network - native platform integrations",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RaceeyXo/use-stellar.git",
    "directory": "packages/react-native"
  },
  "homepage": "https://github.com/RaceeyXo/use-stellar#readme",
  "bugs": {
    "url": "https://github.com/RaceeyXo/use-stellar/issues"
  },
  "main": "dist/index.js",
  "react-native": "./dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "react-native": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./polyfills": {
      "import": {
        "types": "./dist/polyfills.d.mts",
        "default": "./dist/polyfills.mjs"
      },
      "require": {
        "types": "./dist/polyfills.d.ts",
        "default": "./dist/polyfills.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src"
  ],
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "test": "jest --testPathIgnorePatterns=integration",
    "test:watch": "jest --watch --testPathIgnorePatterns=integration",
    "typecheck": "tsc --noEmit",
    "dev": "tsup --watch",
    "lint": "eslint \"src/**/*.{ts,tsx}\" --max-warnings 0",
    "lint:package": "publint && attw --pack ."
  },
  "dependencies": {
    "use-stellar": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-native": ">=0.68.0",
    "@walletconnect/react-native-compat": "^2.0.0",
    "@walletconnect/sign-client": "^2.0.0",
    "buffer": ">=6.0.0",
    "react-native-get-random-values": ">=1.8.0",
    "react-native-url-polyfill": ">=2.0.0",
    "text-encoding": ">=0.7.0"
  },
  "peerDependenciesMeta": {
    "buffer": {
      "optional": true
    },
    "react-native-get-random-values": {
      "optional": true
    },
    "react-native-url-polyfill": {
      "optional": true
    },
    "text-encoding": {
      "optional": true
    },
    "@react-native-async-storage/async-storage": {
      "optional": true
    },
    "@react-native-community/netinfo": {
      "optional": true
    },
    "@walletconnect/react-native-compat": {
      "optional": true
    },
    "@walletconnect/sign-client": {
      "optional": true
    }
  },
  "optionalDependencies": {
    "@react-native-async-storage/async-storage": "^1.21.0",
    "@react-native-community/netinfo": "^11.0.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@testing-library/react-native": "^12.4.0",
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "@types/react": "^18.2.0",
    "@types/react-test-renderer": "^18.3.0",
    "jest": "^29.0.0",
    "publint": "^0.3.9",
    "react": "^18.2.0",
    "react-native": "^0.73.0",
    "react-test-renderer": "18.3.1",
    "ts-jest": "^29.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0"
  },
  "keywords": [
    "stellar",
    "soroban",
    "react",
    "react-native",
    "hooks",
    "blockchain",
    "web3",
    "crypto",
    "xlm",
    "usdc",
    "native"
  ],
  "license": "Apache-2.0"
}
