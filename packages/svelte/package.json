{
  "name": "@use-stellar/svelte",
  "version": "0.2.3",
  "description": "Svelte adapter for the Stellar network, built on use-stellar",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RaceeyXo/use-stellar.git",
    "directory": "packages/svelte"
  },
  "license": "Apache-2.0",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": ["dist"],
  "engines": { "node": ">=20" },
  "sideEffects": false,
  "publishConfig": { "access": "public" },
  "scripts": {
    "build": "tsup",
    "test": "jest",
    "test:package": "node scripts/smoke-test.js",
    "typecheck": "tsc --noEmit",
    "size": "size-limit",
    "size:why": "size-limit --why"
  },
  "peerDependencies": {
    "use-stellar": "workspace:^"
  },
  "devDependencies": {
    "@size-limit/esbuild": "12.1.0",
    "@size-limit/preset-small-lib": "^12.1.0",
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "jest": "^29.0.0",
    "size-limit": "^12.1.0",
    "ts-jest": "^29.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.9.3",
    "use-stellar": "workspace:*"
  },
  "size-limit": [
    {
      "name": "Svelte CommonJS bundle",
      "path": "dist/index.js",
      "limit": "5 kB",
      "ignore": ["use-stellar"]
    }
  ]
}
