{
  "name": "use-stellar",
  "version": "0.2.2",
  "type": "commonjs",
  "description": "React hooks for the Stellar network - the wagmi of Stellar",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RaceeyXo/use-stellar.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/RaceeyXo/use-stellar#readme",
  "bugs": {
    "url": "https://github.com/RaceeyXo/use-stellar/issues"
  },
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "react-native": "./dist/index.react-native.js",
  "types": "dist/index.d.ts",
  "typesVersions": {
    "*": {
      "core": [
        "./dist/core.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "react-native": {
        "types": "./dist/index.react-native.d.ts",
        "default": "./dist/index.react-native.js"
      },
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./core": {
      "import": {
        "types": "./dist/core.d.mts",
        "default": "./dist/core.mjs"
      },
      "require": {
        "types": "./dist/core.d.ts",
        "default": "./dist/core.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src"
  ],
  "engines": {
    "node": ">=20"
  },
  "sideEffects": [
    "./dist/index.js",
    "./dist/index.mjs"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "test": "jest --testPathIgnorePatterns=integration",
    "test:watch": "jest --watch --testPathIgnorePatterns=integration",
    "test:integration": "jest --config jest.integration.config.js",
    "test:package": "node scripts/smoke-test.js",
    "lint:package": "publint && attw --pack . --ignore-rules no-resolution",
    "typecheck": "tsc --noEmit",
    "dev": "tsup --watch",
    "size": "size-limit",
    "size:why": "size-limit --why"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "@albedo-link/intent": "^0.13.0",
    "@stellar/freighter-api": "^6.0.0",
    "@walletconnect/sign-client": "^2.0.0",
    "@creit.tech/xbull-wallet-connect": "*",
    "@hot-wallet/sdk": "*",
    "@trezor/connect": "^9.0.0"
  },
  "peerDependenciesMeta": {
    "react-dom": {
      "optional": true
    },
    "@albedo-link/intent": {
      "optional": true
    },
    "@stellar/freighter-api": {
      "optional": true
    },
    "@walletconnect/sign-client": {
      "optional": true
    },
    "@creit.tech/xbull-wallet-connect": {
      "optional": true
    },
    "@hot-wallet/sdk": {
      "optional": true
    },
    "@trezor/connect": {
      "optional": true
    }
  },
  "dependencies": {
    "@stellar/stellar-sdk": "^12.0.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@albedo-link/intent": "^0.13.0",
    "@stellar/freighter-api": "6.0.1",
    "@size-limit/esbuild": "12.1.0",
    "@size-limit/esbuild-why": "12.1.0",
    "@size-limit/preset-small-lib": "^12.1.0",
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^14.0.0",
    "@testing-library/react-hooks": "^8.0.0",
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "@types/react": "^18.2.0",
    "jest": "^29.0.0",
    "jest-environment-jsdom": "^29.0.0",
    "publint": "^0.3.9",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "size-limit": "^12.1.0",
    "ts-jest": "^29.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0"
  },
  "size-limit": [
    {
      "name": "CommonJS bundle",
      "path": "dist/index.js",
      "limit": "28 kB",
      "ignore": [
        "@stellar/stellar-sdk"
      ]
    },
    {
      "name": "ES module bundle",
      "path": "dist/index.mjs",
      "limit": "28 kB",
      "ignore": [
        "@stellar/stellar-sdk"
      ]
    }
  ],
  "keywords": [
    "stellar",
    "soroban",
    "react",
    "hooks",
    "blockchain",
    "web3",
    "crypto",
    "xlm",
    "usdc"
  ],
  "license": "Apache-2.0"
}
