echo "Running pre-push checks..."

echo "Running code-quality checks..."
pnpm format:check
if [ $? -ne 0 ]; then
  echo "Formatting check failed. Push aborted."
  exit 1
fi

pnpm lint
if [ $? -ne 0 ]; then
  echo "Lint check failed. Push aborted."
  exit 1
fi

echo "Building SDK packages..."
pnpm build:lib
if [ $? -ne 0 ]; then
  echo "SDK build failed. Push aborted."
  exit 1
fi

pnpm typecheck
if [ $? -ne 0 ]; then
  echo "Type check failed. Push aborted."
  exit 1
fi

echo "Running unit tests..."
pnpm test
if [ $? -ne 0 ]; then
  echo "Unit tests failed. Push aborted."
  exit 1
fi

echo "Checking package sizes..."
pnpm size
if [ $? -ne 0 ]; then
  echo "Package size check failed. Push aborted."
  exit 1
fi

echo "All checks passed. Pushing..."
