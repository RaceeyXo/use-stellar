{
  "root": true,
  "parser": "@typescript-eslint/parser",
  "plugins": ["@typescript-eslint", "react-hooks"],
  "extends": ["eslint:recommended", "plugin:@typescript-eslint/recommended"],
  "rules": {
    // Prettier runs with "semi": false, so it emits leading semicolons to
    // protect against ASI hazards (`;(foo as jest.Mock).mockReturnValue(...)`).
    // eslint:recommended's no-extra-semi calls those an error, and the two
    // tools then undo each other on every `--fix` / `--write` pass. Formatting
    // is Prettier's job here, so the rule stands down.
    "no-extra-semi": "off",
    "react-hooks/rules-of-hooks": "error",
    "react-hooks/exhaustive-deps": "warn",
    "@typescript-eslint/no-explicit-any": "error",
    "@typescript-eslint/no-unused-vars": ["error", { "argsIgnorePattern": "^_" }],
    "@typescript-eslint/explicit-function-return-type": "off",
    "no-console": ["warn", { "allow": ["warn", "error"] }]
  },
  "env": {
    "browser": true,
    "node": true,
    "es2020": true
  },
  "overrides": [
    {
      // Vue composables follow the `use*` naming convention but are not React
      // hooks: they run once in `setup()` and have no call-order rules.
      "files": ["packages/vue/**/*.ts"],
      "rules": {
        "react-hooks/rules-of-hooks": "off",
        "react-hooks/exhaustive-deps": "off"
      }
    }
  ],
  "ignorePatterns": ["dist/", ".next/", "node_modules/"]
}
